# Development image. Bun is the package manager of record for this repo, so this
# matches the production Dockerfile rather than keeping a parallel npm setup.
FROM oven/bun:1-alpine

WORKDIR /app

# Copy manifest and lockfile first so the install layer caches independently of
# source changes.
COPY package.json bun.lock ./

RUN bun install --frozen-lockfile

# Make port 3000 available to the world outside this container
EXPOSE 3000

# vite.config.mjs sets `host: true`, which is what makes the dev server bind
# beyond loopback and so be reachable from outside the container.
CMD ["bun", "run", "dev"]
