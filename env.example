# Frontend Environment Variables
# Copy this file to .env for local development
#
# Only variables prefixed VITE_ are exposed to client code. The build-time-only
# knobs (PUBLIC_URL) are passed as build args, not from here.

# API Base URL - scheme + host + port only, NO trailing /api (config.js adds it automatically)
# For development with local backend
VITE_API_BASE_URL=http://localhost:4001

# WebSocket URL - derived automatically from VITE_API_BASE_URL if not set
# Only set this if your WS path differs from the API base URL
VITE_WS_URL=ws://localhost:4001

# For production deployment, use (NO /api suffix — it is added automatically):
# VITE_API_BASE_URL=https://iquana.ni.dfki.de
# VITE_WS_URL=wss://iquana.ni.dfki.de
#
# Vite derives the mode from the command (`vite` = development,
# `vite build` = production) rather than from NODE_ENV; client code reads it
# back as import.meta.env.MODE / .DEV / .PROD.
#
# PUBLIC_URL sets the path prefix the app is served under when it sits behind
# the reverse proxy, e.g. PUBLIC_URL=/iquana. Leave unset to serve from the root.
