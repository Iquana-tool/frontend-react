# Frontend Environment Variables
# Copy this file to .env for local development

# API Base URL - scheme + host + port only, NO trailing /api (config.js adds it automatically)
# For development with local backend
REACT_APP_API_BASE_URL=http://localhost:4001

# WebSocket URL - derived automatically from REACT_APP_API_BASE_URL if not set
# Only set this if your WS path differs from the API base URL
REACT_APP_WS_URL=ws://localhost:4001

# Node environment
NODE_ENV=development

# For production deployment, use (NO /api suffix — it is added automatically):
# REACT_APP_API_BASE_URL=https://iquana.ni.dfki.de
# REACT_APP_WS_URL=wss://iquana.ni.dfki.de
# NODE_ENV=production

